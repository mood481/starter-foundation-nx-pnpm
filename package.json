{
  "name": "starter-foundation-nx-pnpm",
  "version": "0.1.0",
  "private": true,
  "description": "Neutral foundation starter for strict Nx + pnpm multi-language monorepos.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "ospec": "openspec",
    "ospec:list": "openspec list",
    "ospec:list:specs": "openspec list --specs",
    "ospec:validate": "openspec validate --all --strict",
    "ospec:validate:json": "openspec validate --all --strict --json",
    "validate": "pnpm ospec:validate"
  },
  "devDependencies": {
    "@fission-ai/openspec": "~1.4.0"
  }
}
