{
  "name": "@mood481/starter-foundation-nx-pnpm",
  "version": "0.4.0",
  "private": false,
  "description": "Neutral foundation starter for strict Nx + pnpm multi-language monorepos.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "ospec": "openspec",
    "ospec:list": "openspec list",
    "ospec:list:specs": "openspec list --specs",
    "ospec:update": "openspec update",
    "ospec:validate": "openspec validate --all --strict",
    "ospec:validate:json": "openspec validate --all --strict --json",
    "starter:render": "node tools/scripts/render-template.mjs",
    "validate:template:mws": "node tools/scripts/validate-template-render.mjs --variant mws --input examples/render-input.mws.yaml",
    "validate:template": "node tools/scripts/validate-template-render.mjs",
    "validate:spec": "pnpm ospec:validate",
    "validate": "pnpm validate:spec && pnpm validate:template",
    "template:update-lock": "node scripts/update-template-lockfile.mjs"
  },
  "bin": {
    "starter-foundation-render": "tools/scripts/render-template.mjs"
  },
  "files": [
    "tools/scripts/render-template.mjs",
    "tools/scripts/validate-template-render.mjs",
    "starter.yaml",
    "starter.render.yaml",
    "template/**",
    "template/.gitignore",
    "template/.npmrc",
    "variants/**/overlay/**",
    "README.md",
    "VALIDATION.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "~1.11.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@fission-ai/openspec"
    ]
  }
}
