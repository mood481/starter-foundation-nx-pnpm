{
  "name": "starter-foundation-nx-pnpm",
  "version": "0.1.0",
  "private": true,
  "description": "Neutral foundation starter for strict Nx + pnpm multi-language monorepos.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "openspec": "openspec",
    "os:list": "openspec list",
    "os:list:specs": "openspec list --specs",
    "os:status": "openspec status",
    "os:validate": "openspec validate --all --strict",
    "os:validate:json": "openspec validate --all --strict --json",
    "os:validate:change": "openspec validate add-foundation-template-contract --strict",
    "os:update": "openspec update",
    "validate": "pnpm os:validate"
  },
  "devDependencies": {
    "@fission-ai/openspec": "~1.4.0"
  }
}
