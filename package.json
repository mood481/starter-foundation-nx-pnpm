{
  "name": "@mood481/starter-foundation-nx-pnpm",
  "version": "0.8.2",
  "private": false,
  "description": "Neutral foundation starter for strict Nx + pnpm multi-language monorepos.",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm pack:render",
    "pack:render": "node tools/scripts/pack-package.mjs",
    "validate:template:mws": "node tools/scripts/validate-template-render.mjs --input examples/render.mws.yaml",
    "validate:template": "node tools/scripts/validate-template-render.mjs --input examples/render.neutral.yaml",
    "validate": "pnpm test:cli && pnpm validate:template",
    "test:cli": "node --test tools/tests/starter-foundation-render.test.mjs",
    "starter:validate": "starter-validate --type starter starter.yaml",
    "test:render": "starter-render --input examples/render.neutral.yaml",
    "test:render:mws": "starter-render --input examples/render.mws.yaml",
    "publish:render": "node tools/scripts/publish-package.mjs",
    "publish:render:dev": "cp .npmrc.example .npmrc && source .env.publish && NPM_CONFIG_USERCONFIG=.npmrc pnpm publish:render"
  },
  "bin": {
    "starter-foundation-render": "bin/starter-foundation-render.mjs"
  },
  "files": [
    "bin/starter-foundation-render.mjs",
    "tools/scripts/validate-template-render.mjs",
    "starter.yaml",
    "template/**",
    "!template/**/node_modules/**",
    "template/.gitignore",
    "template/.npmrc",
    "variants/**/overlay/**",
    "README.md",
    "VALIDATION.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mood481/starter-renderer": "0.4.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@mood481/starter-contracts": "0.4.0",
    "@mood481/starter-validator": "0.4.0"
  }
}
