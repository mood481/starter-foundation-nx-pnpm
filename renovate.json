{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "baseBranches": ["devel"],
  "gitIgnoredAuthors": ["github-actions[bot]@users.noreply.github.com", "41898282+github-actions[bot]@users.noreply.github.com"],
  "enabledManagers": ["npm"],
  "packageRules": [
    {
      "description": "Disable Renovate for template/package.json entirely; the template is maintained locally by the maintainer via the template lockfile script",
      "matchFileNames": ["template/package.json"],
      "enabled": false
    },
    {
      "description": "Block major pnpm updates (the packageManager pin); minor/patch pnpm still proposed as manual PRs",
      "matchDepNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchDepNames": ["@fission-ai/openspec"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "rebase",
      "platformAutomerge": true
    },
    {
      "matchDepNames": ["@fission-ai/openspec"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
